{
  "name": "file-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The living map of everything on your computer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AhmedIrfan7/file-atlas.git"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter atlas-desktop dev",
    "build": "pnpm --filter atlas-desktop build",
    "tauri:dev": "pnpm --filter atlas-desktop tauri dev",
    "tauri:build": "pnpm --filter atlas-desktop tauri build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0"
  }
}
