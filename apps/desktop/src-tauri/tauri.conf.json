{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "File Atlas",
  "version": "1.0.0",
  "identifier": "com.ahmedirfan.fileatlas",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "File Atlas",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5QzJFQjY5NEVEMjUxRDMKUldUVFVkSk9hZXZDbWF0TUhNdUFnZE16V1BNclV4c1N0WCtLc1BCbzA0UkdxQm5KVlNTeWJkdTIK",
      "endpoints": [
        "https://github.com/AhmedIrfan7/file-atlas/releases/latest/download/latest.json"
      ]
    }
  }
}
